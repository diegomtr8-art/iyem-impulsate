# ── Blindaje: nada de esto debe salir a internet ──────────────────
<FilesMatch "^\.env|^\.env\..*|^\.git.*|\.log$|\.sqlite$|\.sql$|\.bak.*$|\.py$|\.pyc$|\.md$|\.txt$|\.docx$|\.xlsx$|\.html?$|\.json$|\.ya?ml$|\.sh$|\.ini$|\.conf$|\.pem$|\.key$|\.crt$|\.cache$|^\.htpasswd$|^composer\.(json|lock)$|^package(-lock)?\.json$|^phpunit\.xml$|^artisan$|^citas_db$|^(vite|tailwind|postcss|jsconfig)\.(js|json)$">
    Require all denied
</FilesMatch>

# robots.txt SI se sirve (verificado: 200). Va DESPUES del FilesMatch
# porque Apache aplica las secciones en orden y la ultima gana.
<Files "robots.txt">
    Require all granted
</Files>

# Respaldo del bloqueo de directorios, INDEPENDIENTE de mod_rewrite.
# Si mod_rewrite se desactivara, el RewriteRule de abajo dejaria de
# proteger .git/ y el historial completo quedaria descargable.
RedirectMatch 404 ^/(\.git|\.github|vendor|database|bootstrap|config|app|resources|routes|tests|node_modules)(/|$)
# ──────────────────────────────────────────────────────────────────

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Route /storage/ requests to public/storage/ (Laravel symlink lives there)
    RewriteRule ^storage/(.+)$ public/storage/$1 [L]

    # Directorios internos que nunca deben servirse.
    # OJO: 'storage' NO va en esta lista — la regla de arriba ya reescribe
    # /storage/* hacia public/storage/*, y bloquearlo aquí romperia las
    # imagenes de eventos y los assets publicos.
    RewriteRule ^(\.git|vendor|database|bootstrap|config|app|resources|routes|tests|node_modules)/ - [F,L]

    # Archivo con nombre corrupto (ruta de Windows aplanada)
    RewriteRule ^C:xampphtdocscitasdiag\.py$ - [F,L]

    # Static files and directories: serve directly (no rewrite)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through Laravel
    RewriteRule ^ index.php [L]
</IfModule>
